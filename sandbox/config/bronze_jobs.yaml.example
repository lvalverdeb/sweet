# Copy to sandbox/config/bronze_jobs.yaml (gitignored) and fill in real
# values. Placeholders only below — never commit real values here.
#
# Loaded by sweet_etl.BronzeJobs — field names below must match
# sweet_etl.bronze_jobs.BronzeJobConfig/BronzeDestination's own field names.
# `sql_profile`/`destination.filesystem_profile` reference profiles
# registered in datasources.yaml (sql.connections / filesystems).
#
# This only covers source/destination parameters (table, filters, where the
# parquet lands, partition_on, a limit for capping large tables) — it can't
# express fix_data() (int/bool/date coercion, row exclusion, derived fields),
# which stays Python on the BronzeCube subclass. See
# sandbox/notebooks/datacubes.ipynb for CustomerCube/LocaliserCube/
# ProductCube using this file.
#
# `columns` (see `customers`, below) projects a job's load to just the
# fields it actually needs — deliberate for any wide source table; pulling
# every raw column risks the dask meta/schema issues documented in
# sweet_etl/gold.py's module docstring.
#
# Two mutually exclusive extraction strategies (BronzeJobConfig rejects a
# job that sets both):
#
# - watermark_field/watermark_operator/watermark_initial_value (see
#   `products`, below) wire BronzeJobs.load_incremental_kwargs() — *stateful*:
#   cuts the SQL query down to rows newer than the last committed watermark.
#   Requires a `watermark_store=` passed to BronzeJobs() at construction time
#   (e.g. `datasources.watermark_store(filesystem_profile="etl",
#   path="_watermarks.json")`). This is EXTRACT-side only — see
#   sweet_etl/bronze_jobs.py's own module docstring for why the result still
#   can't be fed straight into BronzeCube.save_to_parquet()'s write path
#   without data-loss risk.
# - refresh/refresh_field (see `localiser`, below) wire BronzeJobs.
#   load_kwargs() — *stateless*: a named calendar-relative window
#   ("today"/"current_week"/"current_month"/"ytd"/"itd", see
#   sweet_etl.refresh_presets) recomputed fresh from the real current date on
#   every run, no watermark store involved. Right for "refresh this month's
#   data every run" jobs where re-pulling the same rows repeatedly is fine
#   (or even desired, e.g. to pick up in-place updates a pure watermark would
#   miss) — wrong for a large table where only genuinely-new rows should ever
#   be re-queried.
jobs:
  customers:
    sql_profile: replica
    table: crm_clientes_archivo
    field_map:
      cliente_id: customer_id
      cliente_inactivo: inactive
      cliente_bloqueado: blocked
      cliente_moroso: in_arrears
    columns: [customer_id, inactive, blocked, in_arrears]
    destination:
      filesystem_profile: etl
      path: bronze/customers
    partition_on:
    limit:

  localiser:
    sql_profile: replica
    table: panel_localiser
    destination:
      filesystem_profile: etl
      path: bronze/localiser
    partition_on:
    limit:
    # last_visited_at is this table's own real column name (no field_map
    # renames it) — refresh_field must match whatever name the filter
    # actually runs against, same rule as watermark_field.
    refresh: current_month
    refresh_field: last_visited_at

  products:
    sql_profile: replica
    table: asm_tracking_productos
    field_map:
      cliente_id: customer_id
      id_tipo_producto: product_type_id
      id_track_global: global_track_id
      lock_producto: lock_product
      sub_estatus: sub_status
      escaneado: scanned
      precoordinado: precoordinated
      fh_ultimo_movimiento: last_activity_dt
    sticky_filters:
      product_type_id: 1
    destination:
      filesystem_profile: etl
      path: bronze/products
    partition_on:
    limit: 200
    # last_activity_dt is field_map's *renamed* (semantic) name, not the raw
    # fh_ultimo_movimiento DB column — DataGateway translates filters to the
    # DB's own column names when field_map is set (see boti_data's own
    # DataGateway docstring), so watermark_field must match field_map's
    # right-hand side, same as everything else this job's filters reference.
    watermark_field: last_activity_dt
    watermark_operator: gt
    watermark_initial_value:
