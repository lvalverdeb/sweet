# Copy to sandbox/config/silver_jobs.yaml (gitignored) and fill in real
# values. Placeholders only below — never commit real values here.
#
# Loaded by sweet_etl.SilverJobs — field names below must match
# sweet_etl.silver_jobs.SilverJobConfig/BronzeDestination's own field names.
# `source.filesystem_profile`/`destination.filesystem_profile` reference
# profiles registered in datasources.yaml (filesystems), same as
# bronze_jobs.yaml's `destination.filesystem_profile`.
#
# This only covers source/destination parameters (where the bronze parquet
# is read from, where the cleaned parquet lands, partition_on) — it can't
# express `transformers` (TypeCaster/RowFilter/DerivedColumn/Deduplicator),
# which stays Python on the SilverCube subclass. See
# sandbox/notebooks/silver_layer.ipynb.
jobs:
  products:
    source:
      filesystem_profile: etl
      path: bronze/products
    destination:
      filesystem_profile: etl
      path: silver/products
    partition_on:
