# Copy to sandbox/config/.env (gitignored) and fill in real values for your
# deployment. Placeholders only below — never commit real credentials here.

# boti-sweet itself
BOTI_SWEET_LOG_LEVEL=WARNING

TZ=America/Costa_Rica
# ^ NOT read via BOTI_SWEET_CONFIG_DIR/.env — this suite's settings loader
# only reads .env into a dict for pydantic validation, it never re-exports
# values back into the real process environment. TZ must be exported in the
# actual process environment (shell/systemd/docker `environment:`/...) to
# have any effect; boti_sweet.apply_tz() then picks it up from there.

# --- Storage backends (boti_data.ConnectionCatalog named filesystem profiles) ---
ETL_FS_PATH=s3://dst-etl
ETL_FS_TYPE=s3
ETL_FS_KEY=
ETL_FS_SECRET=
ETL_FS_TOKEN=
ETL_FS_ENDPOINT=

SOURCE_FS_PATH=s3://logistics/source
SOURCE_FS_TYPE=s3
SOURCE_FS_KEY=
SOURCE_FS_SECRET=
SOURCE_FS_TOKEN=
SOURCE_FS_ENDPOINT=

TARGET_FS_PATH=s3://logistics/target
TARGET_FS_TYPE=s3
TARGET_FS_KEY=
TARGET_FS_SECRET=
TARGET_FS_TOKEN=
TARGET_FS_ENDPOINT=

PERSONS_FS_PATH=s3://dst-persons
PERSONS_FS_TYPE=s3
PERSONS_FS_KEY=
PERSONS_FS_SECRET=
PERSONS_FS_TOKEN=
PERSONS_FS_ENDPOINT=

# --- ETL service integration (sandbox-only, client-specific) ---
ETL_SERVICE_URL=http://localhost:7800
ETL_GRPC_SERVER=localhost:50051
ETL_MAX_RANGE_DAYS=90

# --- Databases (boti_data.ConnectionCatalog named SQL profiles + shared pool tuning) ---
REPLICA_DB_URL=
PAF_DB_URL=
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=25
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# --- Redis (no owner yet, unused by any package/sandbox code) ---
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_DECODE_RESPONSES=0

# --- ClickHouse / BI (boti_sweet_bi.ClickHouseSettings) ---
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=0
CLICKHOUSE_VERIFY=0

# --- Dask (boti_dask.dask_session_from_env_prefix) ---
DASK_SCHEDULER_ADDRESS=

# --- Observability (boti_sweet_observability.ObservabilitySettings) ---
# otel_* fields are typed-settings-only for now, no OTEL SDK wired yet.
OO_LOGGER_NAME=
OO_OTEL_GRPC_ENDPOINT=
OO_ENABLE_OTEL=0
OO_OTEL_SERVICE_NAME=
OO_OTEL_STREAM_NAME=
OO_OTEL_INSECURE=0

# --- Routing / geo / external services (sandbox-only, client-specific) ---
OSRM_SERVICE_URL=
OSRM_TIMEOUT=30.0
GEOLOCATOR_TEST_PLACE=
IBIS_PPP_URL=

# --- Security (sandbox-only, client-specific) ---
SECURITY_ENVIRONMENT=development
SECURITY_API_KEY=
