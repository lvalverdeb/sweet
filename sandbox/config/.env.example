# Copy to sandbox/config/.env (gitignored) and fill in real values for your
# deployment. Placeholders only below — never commit real credentials here.

# sweet itself
SWEET_LOG_LEVEL=WARNING

TZ=America/Costa_Rica
# ^ NOT read via SWEET_CONFIG_DIR/.env — this suite's settings loader
# only reads .env into a dict for pydantic validation, it never re-exports
# values back into the real process environment. TZ must be exported in the
# actual process environment (shell/systemd/docker `environment:`/...) to
# have any effect; sweet.apply_tz() then picks it up from there.

# --- Storage backends and database connections ---
# Moved to sandbox/config/datasources.yaml (copy datasources.yaml.example).

# --- ETL service integration (sandbox-only, client-specific) ---
ETL_SERVICE_URL=http://localhost:7800
ETL_GRPC_SERVER=localhost:50051
ETL_MAX_RANGE_DAYS=90

# --- Redis ---
# Moved to sandbox/config/datasources.yaml (sweet_etl.RedisConfig).

# --- ClickHouse / BI (sweet_bi.ClickHouseSettings) ---
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=0
CLICKHOUSE_VERIFY=0

# --- Dask (boti_dask.dask_session_from_env_prefix) ---
DASK_SCHEDULER_ADDRESS=

# --- Observability (sweet_observability.ObservabilitySettings) ---
# otel_* fields are typed-settings-only for now, no OTEL SDK wired yet.
OO_LOGGER_NAME=
OO_OTEL_GRPC_ENDPOINT=
OO_ENABLE_OTEL=0
OO_OTEL_SERVICE_NAME=
OO_OTEL_STREAM_NAME=
OO_OTEL_INSECURE=0

# --- Routing / geo / external services (sandbox-only, client-specific) ---
OSRM_SERVICE_URL=
OSRM_TIMEOUT=30.0
GEOLOCATOR_TEST_PLACE=
IBIS_PPP_URL=

# --- Security (sandbox-only, client-specific) ---
SECURITY_ENVIRONMENT=development
SECURITY_API_KEY=
