# Copy to sandbox/config/datasources.yaml (gitignored) and fill in real
# values. Placeholders only below — never commit real credentials here.
#
# Loaded by sweet_etl.Datasources directly into
# boti.core.filesystem.FilesystemConfig / boti_data.db.sql_config.
# SqlDatabaseConfig / sweet_etl.RedisConfig — field names below must
# match those models' own field names.
filesystems:
  etl:
    fs_type: s3
    fs_path: s3://dst-etl
    fs_key:
    fs_secret:
    fs_endpoint:
  source:
    fs_type: s3
    fs_path: s3://logistics/source
    fs_key:
    fs_secret:
    fs_endpoint:
  target:
    fs_type: s3
    fs_path: s3://logistics/target
    fs_key:
    fs_secret:
    fs_endpoint:
  persons:
    fs_type: s3
    fs_path: s3://dst-persons
    fs_key:
    fs_secret:
    fs_endpoint:

sql:
  # Shared pool tuning applied to every connection below, unless a connection
  # overrides a key itself (e.g. a future `{query_only: false}`).
  defaults:
    pool_size: 20
    max_overflow: 25
    pool_timeout: 30
    pool_recycle: 3600
    query_only: true
  connections:
    replica:
      connection_url:
      # sweet is dask-first (BronzeCube.save_to_parquet() defaults to
      # return_type="dask"), which means loading this profile through a real
      # distributed cluster serializes SqlDatabaseConfig into worker task
      # payloads. Without worker_connection_env_var set,
      # boti_data.db.sql_config.WorkerSqlConfig ships the raw connection_url
      # above (credentials included) to every worker and warns
      # "Credentials may be visible in scheduler logs" at runtime. Set this
      # to an env var name (e.g. REPLICA_DB_URL); boti_data.db.sql_engine
      # resolves it via os.environ.get() inside the code that runs *on the
      # worker*, not the client process building this config, so the value
      # must exist in each worker's own environment, not just here:
      #   - local/default DaskSession (in-process or locally-spawned
      #     workers): they inherit this process's environment, so setting it
      #     wherever you launch the session (shell export, .env loaded
      #     before constructing DaskSession) is enough.
      #   - a real distributed cluster (Kubernetes, SSH, a managed cloud
      #     cluster): each worker runs in its own machine/pod/container, so
      #     the env var must be provisioned there independently (e.g. a
      #     Kubernetes Secret mounted into the *worker* pod spec, not the
      #     client's) — boti_dask has no mechanism to forward env vars from
      #     the client to remote workers, this is cluster/infra config.
      worker_connection_env_var:

redis:
  cache:
    host:
    port: 6379
    db: 0
    decode_responses: false
